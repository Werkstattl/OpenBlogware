{% block blog_detail %}
    {% if element.data %}
        <article class="blog-detail row"
                 itemprop="article"
                 itemscope
                 itemtype="https://schema.org/BlogPosting">
            <div class="main-container">

                <div class="back-svg" data-back>
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="18" viewBox="0 0 19 18" fill="none">
                        <path d="M8.84098 16.6316L1 8.8158L8.84098 1.00001M2.08902 8.8158L17.9888 8.8158" stroke="black"
                              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
            {% block blog_detail_article_blocks %}
                <div class="col-12 blog-detail-article">

                    {% block blog_detail_article_teaser_image %}
                        {% if element.data.detailTeaserImage %}
                            {% set attributes = {
                                'class': 'blog-image-teaser card-img-top mb-3',
                                'alt': (element.data.media.translated.alt ?: element.data.media.fileName),
                                'title': (element.data.media.translated.title ?: element.data.media.fileName)
                            } %}

                            {% sw_thumbnails 'blog-image-teaser' with {
                                media: element.data.media,
                                sizes: {
                                    'xs': '650px',
                                    'sm': '650px',
                                    'md': '650px',
                                    'lg': '900px',
                                    'xl': '1280px',
                                }
                            } %}
                        {% endif %}
                    {% endblock %}

                    {% block blog_detail_article_title %}
                        <h1 class="blog-detail-title" itemprop="headline">
                            {{ element.data.translated.title }}
                        </h1>
                    {% endblock %}

                    {% block blog_detail_article_meta %}
                        {% set showAuthor = element.fieldconfig.elements.showAuthor.value ?? element.config.showAuthor.value %}
                        {% set showCategory = element.fieldconfig.elements.showCategory.value ?? element.config.showCategory.value %}
                        {% if showAuthor or showCategory %}
                            <div class="blog-detail-article-meta">
                                {% block blog_detail_article_meta_author %}
                                    {% if showAuthor and element.data.blogAuthor %}
                                        {% sw_include '@Storefront/storefront/component/blog/_partials/_block_author.html.twig' with {
                                            author: element.data.blogAuthor
                                        } %}
                                    {% endif %}
                                {% endblock %}

                                {% block blog_detail_article_meta_categories %}
                                    {% if showCategory and element.data.blogCategories %}
                                        {% sw_include '@Storefront/storefront/component/blog/_partials/_block_category.html.twig' with {
                                            categories: element.data.blogCategories
                                        } %}
                                    {% endif %}
                                {% endblock %}
                            </div>
                        {% endif %}
                    {% endblock %}
                    {% block blog_detail_article_blocks_content %}
                        {% if not element.data.cmsPage %}
                            <div>
                                {{ element.data.translated.content|raw }}
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
                {% block blog_detail_author %}
                    <div class="main-container-listing">
                        <div class="col-12 author-date-container">
                            <div class="author-container">
                                <p> {{ 'blog.blogDetail.author'|trans }}</p>
                                {% if page.cmsPage.sections|length > 0 %}
                                    {% for section in page.cmsPage.sections %}
                                        {% if section.blocks|length > 0 %}
                                            {% for block in section.blocks %}
                                                {% if block.slots|length > 0 %}
                                                    {% for slot in block.slots %}
                                                        {% if slot.data.blogAuthor %}
                                                            <div class="data">  {{ slot.data.blogAuthor.displayName }}</div>
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </div>

                            {% block blog_detail_article_item_meta_published %}
                                <meta itemprop="datePublished"
                                      content="{{ product.releaseDate|format_date(pattern="dd. MMMM yyyyy", locale=app.request.locale) }}"/>
                            {% endblock %}

                            {% block page_product_detail_review_item_info_date %}
                                <div class="blog-detail-date">
                                    <p> {{ 'blog.blogDetail.date'|trans }}</p>
                                    <div class="data"> {{ element.data.publishedAt|format_date('long', locale=app.request.locale) }}</div>
                                </div>
                            {% endblock %}
                        </div>
                    </div>
                {% endblock %}


                {% block blog_detail_article_blocks_cms %}
                    {% if element.data.cmsPage %}
                        <div class="blog-detail-content p-0">
                            {% set cmsPageClasses = ('cms-page ' ~ element.data.cmsPage.cssClass|striptags)|trim %}
                            <div class="{{ cmsPageClasses }}">
                                {% block page_content_blocks %}
                                    {% sw_include "@Storefront/storefront/page/content/detail.html.twig" with {'cmsPage': element.data.cmsPage} %}
                                {% endblock %}
                            </div>
                        </div>
                    {% endif %}
                {% endblock %}
            {% endblock %}
        </article>
    {% else %}
        {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
            type: "warning",
            content: 'blog.element.detail.warning.content'|trans,
            heading: 'blog.element.detail.warning.heading'|trans
        } %}
    {% endif %}
{% endblock %}
