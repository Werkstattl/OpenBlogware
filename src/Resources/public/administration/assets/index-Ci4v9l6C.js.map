{% block werkl_blog_list %}
<sw-page class="werkl-blog-list">
    {% block werkl_blog_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="werkl_blog_entry"
            :initial-search="term"
            @search="onSearch"
        />
    </template>
    {% endblock %}

    <template #smart-bar-header>
        <h2>
            {% block werkl_blog_list_smart_bar_header_title_text %}
            {{ $tc('werkl-blog.list.textBlogOverview') }}
            {% endblock %}

            {% block werkl_blog_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >
                ({{ total }})
            </span>
            {% endblock %}
        </h2>
    </template>

    <template #language-switch>
        <sw-language-switch @on-change="changeLanguage"/>
    </template>

    {% block werkl_blog_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block werkl_blog_list_smart_bar_actions_add %}
        <mt-button
            variant="primary"
            size="default"
            @click="$router.push({ name: 'blog.module.create' })"
        >
            {{ $tc('werkl-blog.list.buttonAddBlogEntry') }}
        </mt-button>

        <mt-button
            variant="secondary"
            size="default"
            @click="openSponsorPage"
        >
            {{ $tc('werkl-blog.list.buttonSponsor') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    <template #sidebar>
        <werkl-blog-vertical-tabs/>
    </template>

    <template #side-content>
        {% block werkl_blog_category_side_content %}
        <werkl-blog-category-tree
            :categoryId="categoryId"
            :currentLanguageId="currentLanguageId"
            @update:categoryId="changeCategoryId"
        />
        {% endblock %}
    </template>

    <template #content>
        {% block werkl_blog_list_empty_state %}
        <template v-if="!isLoading && !total">
            <mt-empty-state
                v-if="compareVersion('6.7.4.0')"
                :centered="true"
                :icon="$route.meta.$module.icon"
                :headline="isValidTerm(term) ? $tc('sw-empty-state.messageNoResultTitle') : $tc('werkl-blog.list.messageEmpty')"
                :description="isValidTerm(term) ? $tc('sw-empty-state.messageNoResultSubline') : $tc($route.meta.$module.description)"
                :link-text="isValidTerm(term) ? $tc('sw-empty-state.messageNoResultLink') : ''"
                :link-href="isValidTerm(term) ? $router.resolve({ name: 'sw.profile.index.searchPreferences' }).href : ''"
            />
            <sw-empty-state
                v-else
                :title="isValidTerm(term) ? $tc('sw-empty-state.messageNoResultTitle') : $tc('werkl-blog.list.messageEmpty')"
            >
                {{ isValidTerm(term) ? $tc('sw-empty-state.messageNoResultSubline') : $tc($route.meta.$module.description) }}
            </sw-empty-state>
        </template>
        {% endblock %}

        {% block werkl_blog_list_content %}
        <sw-entity-listing
            v-else-if="entitySearchable"
            {#
            @deprecated
            tag:v6.8.0
            -
            Property
            items
            will
            be
            removed.
            data-source
            will
            be
            used
            instead.
            #}
            :items="blogEntries"
            :data-source="blogEntries"
            :columns="columns"
            :repository="blogEntryRepository"
            detail-route="blog.module.detail"
            :show-selection="false"
            :is-loading="isLoading"
            identifier="werkl-blog-list"
            @update-records="updateTotal"
        >
            {% block werkl_blog_list_grid_columns_name %}
            <template #column-active="{ item, isInlineEdit }">
                {% block werkl_blog_list_grid_columns_name_inline_edit %}
                <template v-if="isInlineEdit">
                    <mt-checkbox v-model:checked="item.active"/>
                </template>
                {% endblock %}

                {% block werkl_blog_list_grid_columns_name_content %}
                <template v-else>
                    <mt-icon
                        v-if="item.active"
                        name="regular-checkmark-xs"
                        size="16px"
                        class="is--active"
                    />
                    <mt-icon
                        v-else
                        name="regular-times-xs"
                        size="16px"
                        class="is--inactive"
                    />
                </template>
                {% endblock %}
            </template>
            {% endblock %}

            {% block werkl_blog_list_grid_columns_author %}
            <template #column-author="{ item }">
                {% block werkl_blog_list_grid_columns_author_content %}
                <router-link
                    :to="{ name: 'blog.module.author.detail', params: { id: item.authorId } }"
                >
                    {{ salutation(item.blogAuthor) }}
                </router-link>
                {% endblock %}
            </template>
            {% endblock %}

            {% block werkl_blog_list_grid_columns_published %}
            <template #column-publishedAt="{ item }">
                {{ dateFilter(item.publishedAt, { hour: undefined, minute: undefined }) }}
            </template>
            {% endblock %}

            {% block werkl_blog_list_grid_actions %}
            <template #more-actions="{ item }">
                {% block werkl_blog_list_grid_actions_duplicate %}
                <sw-context-menu-item @click="onDuplicate(item)">
                    {{ $tc('sw-cms.components.cmsListItem.duplicate') }}
                </sw-context-menu-item>
                {% endblock %}
            </template>
            {% endblock %}
        </sw-entity-listing>
        {% endblock %}
    </template>
</sw-page>
{% endblock %}