parameters:
    level: max
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
    excludePaths:
        - vendor (?)
    ignoreErrors:
        # EntitySearchResult remains supported in 6.8; only its EntityCollection
        # inheritance changes. Ignore the class warning for APIs that remain valid.
        -
            identifier: method.deprecatedClass
            message: '#^Call to method (getEntities|getCriteria)\(\) of deprecated class Shopware\\Core\\Framework\\DataAbstractionLayer\\Search\\EntitySearchResult:\ntag:v6\.8\.0 reason:class-hierarchy-change - Will no longer extend EntityCollection, but will keep extending Struct\.$#'
        -
            identifier: return.deprecatedClass
            message: '#^Return type of method .* has typehint with deprecated class Shopware\\Core\\Framework\\DataAbstractionLayer\\Search\\EntitySearchResult:\ntag:v6\.8\.0 reason:class-hierarchy-change - Will no longer extend EntityCollection, but will keep extending Struct\.$#'
        -
            identifier: parameter.deprecatedClass
            message: '#^Parameter .* has typehint with deprecated class Shopware\\Core\\Framework\\DataAbstractionLayer\\Search\\EntitySearchResult:\ntag:v6\.8\.0 reason:class-hierarchy-change - Will no longer extend EntityCollection, but will keep extending Struct\.$#'
